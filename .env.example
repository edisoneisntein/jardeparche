# ─── NVIDIA NIM (brain) ─────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_TIMEOUT_MS=60000
NVIDIA_MAX_TOKENS=2048
NVIDIA_TEMPERATURE=0.2
# "auto" | "openai" (streaming) | "disabled"
NVIDIA_STREAMING=auto

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Comma separated list of allowed browser origins. Empty = allow localhost only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional single-user access token. If set, HTTP/WS require it.
JARVIS_ACCESS_TOKEN=
# Comma separated user ids allowed to exist. Default: "local"
JARVIS_USERS=local
LOG_LEVEL=info

# ─── Persistence (PostgreSQL + pgvector) ────────────────────────────
DATABASE_URL=postgres://jarvis:jarvis@localhost:55432/jarvis
# Set false to run the server with the in-process store (no persistence across restarts).
PERSISTENCE=postgres
# Retention of episodic memory, in days. 0 = keep forever.
MEMORY_RETENTION_DAYS=0

# ─── Tools ──────────────────────────────────────────────────────────
# Directories the document reader may access (colon separated). Empty = tool unavailable.
DOCUMENTS_ROOT=
# Optional web search provider. Supported: brave | tavily. If unset, web_search reports "unavailable".
# Proveedor: federated (gratis, sin clave) | brave | tavily | endless (SearXNG).
# `federated` consulta en paralelo: DuckDuckGo (web + definiciones), Wikipedia,
# Google News RSS, Hacker News y Stack Exchange. No exige ninguna credencial.
WEB_SEARCH_PROVIDER=federated
# Clave de Brave o Tavily (obligatoria si el proveedor es brave o tavily).
WEB_SEARCH_API_KEY=
# Proveedor "endless": instancia SearXNG con salida JSON.
ENDLESS_BASE_URL=https://api.endless.sbs
# Opcional: sólo las instancias privadas la exigen.
ENDLESS_API_KEY=
# Motores concretos del metasearch (vacío = los de la instancia).
WEB_SEARCH_ENGINES=

# ─── Voz (síntesis en el servidor, macOS) ─────────────────────────────
# El servidor sintetiza la respuesta con `say` (WAV PCM 22 050 Hz, sin coste
# ni claves) y la envía frase a frase: la voz empieza antes de que la
# respuesta esté completa. Sin motor disponible, el cliente recurre a la voz
# del navegador.
# Voz concreta. Déjala VACÍA para que el servidor elija sola: busca una voz
# realista de hombre ("Jorge", "Juan") y, si no está instalada, cae en una voz
# de carácter ("Reed") antes que en una de mujer. "Jorge" se descarga en
# Ajustes del Sistema → Accesibilidad → Contenido hablado → Voces del sistema.
VOICE_TTS_NAME=
VOICE_TTS_CACHE_DIR=
# Turnos de voz sin razonamiento del modelo: el primer token pasa de 1 136 ms a
# 199 ms y la herramienta se sigue usando igual.
VOICE_FAST_TURNS=true

# ─── ASR del servidor (reconocimiento de voz) ────────────────────────────
# El navegador captura el PCM (16 kHz mono) y el servidor lo transcribe y
# decide el fin de la intervención (VAD).
#   · omni (nvidia/nemotron-3-nano-omni-30b-a3b-reasoning): viene en tu cuenta,
#     ~0,8 s por frase. Es el valor por defecto.
#   · parakeet-tdt-0.6b / parakeet-ctc-0.6b-es: hay que HABILITARLO en
#     build.nvidia.com; es purpose-built y más rápido.
# Si el modelo no está disponible, el cliente usa el reconocedor del navegador.
VOICE_ASR_ENABLED=true
# Por defecto: el modelo omni, que YA está en tu cuenta (no hay que habilitar
# nada). Alternativa más rápida si la habilitas: nvidia/parakeet-tdt-0.6b.
VOICE_ASR_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
VOICE_ASR_LANGUAGE=es
VOICE_ASR_SAMPLE_RATE=16000
# Vacío = la misma base que NVIDIA. Útil si autoalojas el NIM de ASR.
VOICE_ASR_BASE_URL=

# ─── Voice (server-side provider hints) ─────────────────────────────
# The browser provides STT/TTS via Web Speech API. Server providers are optional.
VOICE_STT_PROVIDER=browser
VOICE_TTS_PROVIDER=browser

# ─── HTTPS opcional (pnpm dev:https) ────────────────────────────────
# Rutas al certificado y la clave locales generados por mkcert. Con estas
# variables el servidor y el HUD se sirven por HTTPS, requisito para que el
# micrófono funcione desde una IP de red local (un origen HTTP no confiable
# no puede obtener permisos de micrófono en Chrome).
JARVIS_HTTPS_CERT=
JARVIS_HTTPS_KEY=

# ─── Proveedor de respaldo (OpenRouter) ─────────────────────────────────
# Cadena de proveedores: NVIDIA NIM es el primario y OpenRouter el respaldo.
# Si el primario falla por red, timeout, 5xx, rate limit o credenciales, el
# turno se reintenta con el respaldo. Sin OPENROUTER_API_KEY no hay respaldo
# (el sistema lo declara: "openrouter sin configurar").
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3.1-flash
# Profundidad del razonamiento del respaldo: low | medium | high | xhigh | max.
# Para una ruta de voz, "low": con "max" el TTFT del respaldo empeora justo en
# la incidencia, que es cuando más lo necesitas.
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MAX_RETRIES=1

# ─── Sandbox de ejecución de código ─────────────────────────────────
# Imágenes de contenedor para `code.execute_interpreter` y `code.compile_and_run`.
# Si una imagen falta, la tool se reporta como NO DISPONIBLE (no se simula).
# Construye la imagen de compilación con: pnpm sandbox:build
JARVIS_SANDBOX_IMAGE_PYTHON=python:3.12-slim
JARVIS_SANDBOX_IMAGE_NODEJS=node:22-slim
JARVIS_SANDBOX_IMAGE_CPP=jarvis-sandbox:latest
JARVIS_SANDBOX_IMAGE_RUST=jarvis-sandbox:latest
JARVIS_SANDBOX_IMAGE_GO=jarvis-sandbox:latest

# ─── Workspace de filesystem y shell ─────────────────────────────────
# Workspace raíz de `file.io` y `shell.execute` (por defecto ~/.jarvis/workspace).
JARVIS_WORKSPACE_ROOT=
# Binarios permitidos para `shell.execute` (lista separada por comas).
JARVIS_SHELL_ALLOWLIST=ls,pwd,cat,grep,find,git,node,npm,pnpm,python3,wc,head,tail
# Control de interfaz (macOS, CoreGraphics). Encendido: mueve tu ratón y
# teclea en tu pantalla. CADA acción pide aprobación explícita en la interfaz
# (si la rechazas, no se ejecuta nada y JARVIS dice el motivo real).
# Ponlo en false para desactivarlo por completo.
JARVIS_ENABLE_COMPUTER_USE=true
# Driver de control de interfaz (macOS, CoreGraphics).
JARVIS_COMPUTER_USE_DRIVER=

# ─── Frontend ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8787
